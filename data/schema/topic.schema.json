{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyber-pulse-academy.local/schema/topic.schema.json",
  "title": "Topic",
  "description": "A single catalog entry. One JSON file per topic lives in data/<type>/<id>.json and is the single source of truth for that entry. data/catalog.json is generated from these files and must never be edited by hand.",
  "type": "object",
  "required": ["id", "type", "title", "shortTitle", "theme", "summary", "beginner", "tags", "sources", "lastReviewed"],
  "additionalProperties": false,

  "$defs": {
    "exercise": {
      "type": "object",
      "description": "One exercise page. A topic may have any number of these, from zero upwards.",
      "required": ["title", "path", "status"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 200 },
        "path": {
          "type": "string",
          "pattern": "^exercises/[A-Za-z0-9 .,_+()&'-]+/[A-Za-z0-9 .,_+()&'-]+\\.html$",
          "description": "Repository-relative path to the exercise HTML file. It may sit in any folder under exercises/ and use any file name, so the owner can keep their own naming."
        },
        "kind": {
          "enum": ["lesson", "quiz", "lab", "exam", "scenario"],
          "default": "exam",
          "description": "Shown as a chip next to the exercise button."
        },
        "status": {
          "enum": ["missing", "draft", "published"],
          "default": "published",
          "description": "missing shows a disabled card. published requires the file to exist, which the validator enforces."
        },
        "summary": { "type": "string", "maxLength": 400, "description": "One sentence describing what the learner will do." },
        "minutes": { "type": "integer", "minimum": 1, "maximum": 600 },
        "note": { "type": "string", "maxLength": 300 }
      }
    },

    "chapter": {
      "type": "object",
      "description": "One chapter of a certification, normally derived from an official exam domain or objective.",
      "required": ["number", "title", "objectives", "exercises"],
      "additionalProperties": false,
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 99 },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "weight": { "type": "string", "maxLength": 24, "description": "Exam weighting as published by the vendor, for example '33%'. Optional." },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 4 },
          "description": "What this chapter covers, paraphrased from the vendor's publicly available objectives."
        },
        "exercises": { "type": "array", "items": { "$ref": "#/$defs/exercise" } }
      }
    },

    "beginner": {
      "type": "object",
      "description": "The plain-language introduction shown at the top of every topic page. Written at CEFR B1 so a reader with no security background can follow it.",
      "required": ["definition", "whyItMatters", "howItWorks", "example", "takeaways"],
      "additionalProperties": false,
      "properties": {
        "definition": { "type": "string", "minLength": 80, "maxLength": 700 },
        "whyItMatters": { "type": "string", "minLength": 80, "maxLength": 900 },
        "howItWorks": { "type": "array", "minItems": 3, "maxItems": 8, "items": { "type": "string", "minLength": 20, "maxLength": 400 } },
        "example": { "type": "string", "minLength": 80, "maxLength": 1200 },
        "takeaways": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "minLength": 20, "maxLength": 300 } }
      }
    }
  },

  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$", "description": "URL-safe unique id. Becomes topics/<id>.html." },
    "type": { "enum": ["keyword", "certification", "tactic", "technique", "mitigation", "detection", "group"] },
    "title": { "type": "string", "minLength": 3, "maxLength": 160 },
    "shortTitle": { "type": "string", "minLength": 2, "maxLength": 60 },
    "externalId": { "type": "string", "maxLength": 40, "description": "e.g. T1059, TA0002, G0007, CS0-003." },
    "theme": { "type": "string", "minLength": 2, "description": "Grouping used on listing pages, for example 'Network Security' or 'CompTIA'." },
    "summary": { "type": "string", "minLength": 200, "description": "Human intro paragraph for a professional reader, 200+ characters. Also used as the meta description." },
    "beginner": { "$ref": "#/$defs/beginner" },
    "objectives": { "type": "array", "items": { "type": "string", "minLength": 4 } },
    "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9 +./-]{0,40}$" } },
    "difficulty": { "enum": ["hard", "very-hard", "extreme"], "default": "extreme" },

    "exercises": {
      "type": "array",
      "items": { "$ref": "#/$defs/exercise" },
      "description": "The topic's exercise pages. Any number, including zero. Certifications normally leave this empty and put their exercises inside chapters instead."
    },
    "chapters": {
      "type": "array",
      "items": { "$ref": "#/$defs/chapter" },
      "description": "Certifications only. Each chapter carries its own exercise list."
    },

    "relatedTopics": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 3 },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "attributionNote": { "type": "string" },
    "lastReviewed": { "type": "string", "format": "date" },

    "parentTactic": { "type": "string", "pattern": "^ta[0-9]{4}$" },
    "isSubTechnique": { "type": "boolean" },
    "parentTechnique": { "type": "string" },
    "mitigatesTechniques": { "type": "array", "items": { "type": "string" } },
    "detectsTechniques": { "type": "array", "items": { "type": "string" } },
    "techniqueId": { "type": "string" },
    "dataSources": { "type": "array", "items": { "type": "string" } },
    "logic": { "type": "string" },
    "pseudoQuery": { "type": "string" },
    "falsePositives": { "type": "array", "items": { "type": "string" } },
    "tuningNotes": { "type": "string" },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "linkedTechniques": { "type": "array", "items": { "type": "string" } },
    "linkedSoftware": { "type": "array", "items": { "type": "string" } },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "vendor": { "type": "string" },
    "examCode": { "type": "string" },
    "contributors": { "type": "array", "items": { "type": "string" } }
  },

  "allOf": [
    {
      "$comment": "A certification is organised by chapter, because a certification is a syllabus.",
      "if": { "properties": { "type": { "const": "certification" } }, "required": ["type"] },
      "then": { "required": ["chapters"] }
    },
    {
      "$comment": "Everything that is not a certification uses the flat exercise list.",
      "if": {
        "properties": { "type": { "enum": ["keyword", "tactic", "technique", "mitigation", "detection", "group"] } },
        "required": ["type"]
      },
      "then": { "required": ["exercises"] }
    },
    {
      "$comment": "MITRE-derived and vendor-derived content must carry a notice.",
      "if": {
        "properties": { "type": { "enum": ["certification", "tactic", "technique", "mitigation", "detection", "group"] } },
        "required": ["type"]
      },
      "then": { "required": ["attributionNote"] }
    },
    {
      "if": { "properties": { "type": { "const": "technique" } }, "required": ["type"] },
      "then": { "required": ["parentTactic"] }
    },
    {
      "if": { "properties": { "type": { "const": "mitigation" } }, "required": ["type"] },
      "then": { "required": ["mitigatesTechniques"] }
    },
    {
      "if": { "properties": { "type": { "const": "detection" } }, "required": ["type"] },
      "then": { "required": ["techniqueId", "dataSources", "logic", "pseudoQuery", "falsePositives", "tuningNotes", "severity", "attributionNote"] }
    },
    {
      "if": { "properties": { "type": { "const": "group" } }, "required": ["type"] },
      "then": { "required": ["externalId", "linkedTechniques", "linkedSoftware", "attributionNote"] }
    }
  ]
}
