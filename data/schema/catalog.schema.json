{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybermastery.local/schema/catalog.schema.json",
  "title": "Catalog",
  "description": "Generated by scripts/build_catalog.py. NEVER hand-edit data/catalog.json - it is overwritten on every build and CI will detect drift.",
  "type": "object",
  "required": ["version", "generatedAt", "contentHash", "siteVersion", "totals", "coverage", "themes", "topics"],
  "properties": {
    "version": { "type": "string", "description": "Schema/manifest major version." },
    "generatedAt": { "type": "string" },
    "contentHash": { "type": "string", "pattern": "^sha256-[0-9a-f]{16,64}$" },
    "siteVersion": { "type": "string" },
    "totals": {
      "type": "object",
      "required": ["keywords", "certifications", "tactics", "techniques", "mitigations", "detections", "groups"],
      "properties": {
        "keywords": { "type": "integer", "minimum": 0 },
        "certifications": { "type": "integer", "minimum": 0 },
        "tactics": { "type": "integer", "minimum": 0 },
        "techniques": { "type": "integer", "minimum": 0 },
        "mitigations": { "type": "integer", "minimum": 0 },
        "detections": { "type": "integer", "minimum": 0 },
        "groups": { "type": "integer", "minimum": 0 },
        "batchesPublished": { "type": "integer", "minimum": 0 },
        "batchesMissing": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["with0Batches", "with1Batch", "with2Batches", "with3Batches"],
      "properties": {
        "with0Batches": { "type": "array", "items": { "type": "string" } },
        "with1Batch": { "type": "array", "items": { "type": "string" } },
        "with2Batches": { "type": "array", "items": { "type": "string" } },
        "with3Batches": { "type": "array", "items": { "type": "string" } }
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "count"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 },
          "type": { "type": "string" }
        }
      }
    },
    "topics": { "type": "array", "items": { "$ref": "topic.schema.json" } }
  }
}
