# CyberPulseAcademy line-ending and diff policy.
#
# Why this file exists: the build scripts compare generated output against the
# committed output and fail CI when it differs. On Windows, an editor or a shell
# that writes CRLF would make every file look changed, which turns that check
# into noise and hides the real drift it exists to catch. Normalising to LF on
# commit removes the whole class of problem.

# Default: let git decide text versus binary, and check out LF everywhere.
* text=auto eol=lf

# Source and content files: always text, always LF.
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.svg    text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.py     text eol=lf
*.txt    text eol=lf
robots.txt        text eol=lf
sitemap.xml       text eol=lf
.nojekyll         text eol=lf
CNAME             text eol=lf
LICENSE           text eol=lf
LICENSE-CONTENT   text eol=lf

# Raster assets must never be touched by end-of-line conversion. A single
# rewritten byte corrupts a PNG.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated content that is committed on purpose. Keeping them marked as
# generated stops reviewers and diff tools from rendering them inline, because
# assets/img/og/ holds hundreds of near-identical preview cards.
data/catalog.json        linguist-generated=true
assets/img/og/*          linguist-generated=true
topics/*                 linguist-generated=true
sitemap.xml              linguist-generated=true
robots.txt               linguist-generated=true

# Keep documentation and configuration visible in the GitHub language bar
# rather than letting generated SVG output dominate the statistics.
assets/img/*.svg         linguist-documentation=true
docs/*                   linguist-documentation=true
